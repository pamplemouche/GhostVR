<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:background="?settingsPageBackground" android:layout_width="fill_parent" android:layout_height="fill_parent" style="@style/Oculus.Widget.GrayDividers"
