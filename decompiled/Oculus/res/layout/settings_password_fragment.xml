<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:background="?settingsPageBackground" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/settings_item_label_margin_top" style="@style/Oculus.Widget.Light.Setting">
        <TextView android:textAppearance="?android:textAppearance" android:id="@id/description" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/settings_reset_password_description" />
        <TextView android:textAppearance="?android:textAppearance" android:textColor="@color/oculus_blue" android:id="@id/forgot_password" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/common_forgot_your_password" />
        <com.google.android.material.textfield.TextInputLayout android:id="@id/old_password" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/settings_top_padding" style="?textInputLayoutStyle">
            <androidx.appcompat.widget.AppCompatEditText android:textAppearance="?android:textAppearance" android:layout_width="fill_parent" android:layout_height="fill_parent" android:hint="@string/settings_old_password" android:inputType="textPassword" android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@id/new_password" android:layout_width="fill_parent" android:layout_height="wrap_content" style="?textInputLayoutStyle">
            <androidx.appcompat.widget.AppCompatEditText android:textAppearance="?android:textAppearance" android:layout_width="fill_parent" android:layout_height="fill_parent" android:hint="@string/settings_new_password" android:inputType="textPassword" android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@id/retype_new_password" android:layout_width="fill_parent" android:layout_height="wrap_content" style="?textInputLayoutStyle">
            <androidx.appcompat.widget.AppCompatEditText android:textAppearance="?android:textAppearance" android:layout_width="fill_parent" android:layout_height="fill_parent" android:hint="@string/settings_re_type_password" android:inputType="textPassword" android:imeOptions="actionSend" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.oculus.horizon.widget.ProgressButton android:id="@id/save_button" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/common_save" />
    </LinearLayout>
</ScrollView>