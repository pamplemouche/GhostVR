<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#ff242424" android:endColor="#ff242424" android:angle="0.0" android:type="linear" android:gradientRadius="25.0" android:centerColor="#ff646464" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#ff242424" android:endColor="#ff242424" android:angle="0.0" android:type="linear" android:centerColor="#ff545454" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#ff242424" android:endColor="#ff242424" android:angle="0.0" android:type="linear" android:centerColor="#ff444444" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>