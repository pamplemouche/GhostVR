<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:height="42.0px" android:width="42.0px" android:drawable="@drawable/ic_notif_checkmark_selected" />
        </layer-list>
    </item>
    <item android:state_hovered="true">
        <layer-list>
            <item android:height="42.0px" android:width="42.0px" android:drawable="@drawable/ic_notif_checkmark_hover" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:height="42.0px" android:width="42.0px" android:drawable="@drawable/ic_notif_checkmark_default" />
        </layer-list>
    </item>
</selector>