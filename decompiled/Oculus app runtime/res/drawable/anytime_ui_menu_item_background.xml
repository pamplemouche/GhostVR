<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_hovered="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/anytime_detail_button_corner_radius" />
                    <solid android:color="@color/white_a10" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true" android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/anytime_detail_button_corner_radius" />
                    <solid android:color="@color/white_a10" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_hovered="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/anytime_detail_button_corner_radius" />
                    <solid android:color="@color/white_a05" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/anytime_detail_button_corner_radius" />
                    <solid android:color="@color/white_a05" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/anytime_detail_button_corner_radius" />
                    <solid android:color="@color/white_a10" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:gravity="bottom" android:bottom="5.0dip">
                <shape>
                    <size android:height="0.0dip" />
                    <solid android:color="@color/blue_3" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>