<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorAnytimeBarNavButtonBackgroundV2" />
                </shape>
            </item>
            <item android:gravity="top" android:bottom="0.0dip">
                <shape>
                    <size android:height="4.0dip" />
                    <solid android:color="@color/colorAnytimeBarNavButtonTopBarSelectedV2" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorAnytimeBarNavButtonBackgroundV2" />
                </shape>
            </item>
            <item android:gravity="top" android:bottom="0.0dip">
                <shape>
                    <size android:height="4.0dip" />
                    <solid android:color="@color/colorAnytimeBarNavButtonTopBarPressedV2" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_hovered="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorAnytimeBarNavButtonBackgroundV2" />
                </shape>
            </item>
            <item android:gravity="top" android:bottom="0.0dip">
                <shape>
                    <size android:height="4.0dip" />
                    <solid android:color="@color/colorAnytimeBarNavButtonTopBarHoveredV2" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/colorAnytimeBarNavButtonBackgroundV2" />
                </shape>
            </item>
            <item android:gravity="top" android:bottom="0.0dip">
                <shape>
                    <size android:height="4.0dip" />
                    <solid android:color="@color/colorAnytimeBarNavButtonBackgroundV2" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>