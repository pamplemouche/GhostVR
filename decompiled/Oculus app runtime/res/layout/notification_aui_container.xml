<?xml version="1.0" encoding="utf-8"?>
<LinearLayout style="@style/NotificationAUIContainer"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout style="@style/NotificationAUIContainerSeparator">
        <LinearLayout android:id="@id/notifications_aui_main_container" style="@style/NotificationAUIMainContainer">
            <FrameLayout android:id="@id/notif_content_container" style="@style/NotificationContentContainer" />
            <Space style="@style/AnytimeMenuBarSpacerTheme" />
