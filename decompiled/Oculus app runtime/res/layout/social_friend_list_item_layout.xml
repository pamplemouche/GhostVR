<?xml version="1.0" encoding="utf-8"?>
<LinearLayout style="@style/SocialListRowTheme"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout style="@style/SocialListRowContentTheme">
        <ImageView android:id="@id/profile_picture" style="@style/SocialListRowProfilePhotoTheme" />
        <LinearLayout style="@style/SocialListRowDescriptionContainerTheme">
            <TextView android:id="@id/display_name" style="@style/SocialListRowDescriptionTheme" />
            <TextView android:id="@id/presence_status" style="@style/SocialListRowDescriptionTheme" />
        </LinearLayout>
        <ImageButton android:id="@id/action_icon" android:clickable="false" style="@style/SocialListRowActionIconTheme" />
    </LinearLayout>
</LinearLayout>