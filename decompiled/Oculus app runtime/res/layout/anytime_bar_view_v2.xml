        <com.oculus.panelapp.anytimeui.v2.bar.AnytimeBarNavigationButtonV2 android:id="@id/tablet_notifications" android:tag="NOTIFICATIONS" android:background="@drawable/anytime_bar_nav_button_background_v2" android:text="@string/anytime_bar_nav_notifications_v2" android:drawableTop="@drawable/anytime_bar_nav_button_notifications_v2" android:drawablePadding="10.0dip" style="@style/AnytimeBarNavigationButtonV2" />
        <com.oculus.panelapp.anytimeui.v2.bar.AnytimeBarNavigationButtonV2 android:id="@id/tablet_share" android:tag="SHARING" android:background="@drawable/anytime_bar_nav_button_background_v2" android:text="@string/anytime_bar_nav_sharing_v2" android:drawableTop="@drawable/anytime_bar_nav_button_sharing_v2" android:drawablePadding="10.0dip" style="@style/AnytimeBarNavigationButtonV2" />
