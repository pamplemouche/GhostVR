            <View android:id="@id/status_do_not_disturb_icon_v2" android:background="@drawable/anytime_status_donotdisturb" android:visibility="gone" style="@style/AnytimeStatusIconTheme" />
            <View android:id="@id/status_airplane_icon_v2" android:background="@drawable/anytime_status_airplane" android:visibility="gone" style="@style/AnytimeStatusIconTheme" />
            <View android:id="@id/status_bluetooth_icon_v2" android:background="@drawable/anytime_status_bluetooth_on" android:visibility="gone" style="@style/AnytimeStatusIconTheme" />
