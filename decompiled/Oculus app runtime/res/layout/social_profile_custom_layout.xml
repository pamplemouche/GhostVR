<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <LinearLayout android:gravity="center" android:layout_gravity="center" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:textSize="18.0sp" android:textColor="@color/colorAnytimeDialogDescriptionText" android:id="@id/social_profile_user_alias" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@id/social_profile_activity" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <ImageView android:layout_gravity="center_horizontal" android:id="@id/social_profile_avatar_picture" style="@style/AnytimeSocialAvatarTheme" />
    </LinearLayout>
</RelativeLayout>