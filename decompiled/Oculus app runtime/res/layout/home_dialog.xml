<?xml version="1.0" encoding="utf-8"?>
<com.oculus.panelapp.anytimeui.dialogs.HomeDialog style="@style/HomeDialogStyle"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:layout_width="fill_parent" android:layout_height="fill_parent">
        <ImageView android:id="@id/home_dialog_home_img" style="@style/HomeDialogBackgroundImageStyle" />
        <LinearLayout android:gravity="top" android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent">
            <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="112.0px">
                <TextView android:id="@id/home_dialog_app_name" style="@style/HomeDialogGameNameStyle" />
            </LinearLayout>
            <TextView android:textColor="@color/colorAnytimeDialogTitleText" android:text="@string/home_dialog_text_paused" style="@style/HomeDialogGamePausedStyle" />
            <LinearLayout style="@style/HomeDialogButtonLayoutStyle">
                <com.oculus.vrshell.panels.views.ShellButton android:id="@id/home_dialog_button_quit" android:layout_width="110.0px" android:text="@string/home_dialog_button_quit" android:drawableTop="@drawable/home_dialog_option_quit" style="@style/HomeDialogButtonStyle" />
                <com.oculus.vrshell.panels.views.ShellButton android:id="@id/home_dialog_button_resume" android:layout_width="110.0px" android:text="@string/home_dialog_button_resume" android:drawableTop="@drawable/home_dialog_option_resume" style="@style/HomeDialogButtonStyle" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:gravity="bottom|center" android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="fill_parent">
            <com.oculus.vrshell.panels.views.ShellButton android:id="@id/home_dialog_button_bug_report" android:text="@string/home_dialog_button_bug_report" android:drawableRight="@drawable/home_dialog_option_bug_report" style="@style/HomeDialogBugReportButtonStyle" />
        </LinearLayout>
    </FrameLayout>
</com.oculus.panelapp.anytimeui.dialogs.HomeDialog>